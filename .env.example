SECRET_KEY=
DATABASE_PATH=data/minilms.db
# Cookie Secure flag: leave empty (auto: on in production, off in debug/tests).
# Set to 0 only to run over plain http on a machine where login cookies are rejected.
SESSION_COOKIE_SECURE=

# Number of proxies in front of the app whose X-Forwarded-For header is trusted.
# Leave empty: 0 locally, 2 automatically on Render (Cloudflare + Render proxy).
# A wrong value makes visitors look alike or lets forged headers through.
TRUSTED_PROXY_COUNT=
